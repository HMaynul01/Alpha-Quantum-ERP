# ═══════════════════════════════════════════════════════════════
# Alpha Quantum ERP v18 — Environment Variables
# Copy this to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════════

# NeonDB — get from: console.neon.tech → Project → Connection Details
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# JWT — auto-generated by deploy script, or: openssl rand -hex 64
JWT_SECRET=replace-with-64-char-random-hex-string

# Creator master account
CREATOR_USERNAME=maynulshaon
CREATOR_PASSWORD=Creator@2025!
CREATOR_EMAIL=erp@alpha-01.info
CREATOR_FULL_NAME=System Creator

# IONOS SMTP (erp@alpha-01.info)
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_USER=erp@alpha-01.info
SMTP_PASS=your-ionos-email-password
SMTP_FROM=Alpha Quantum ERP <erp@alpha-01.info>
SMTP_REPLY_TO=reply@alpha-01.info

# Cloudflare R2 Storage (optional — for file uploads)
# CF_ACCOUNT_ID=your-account-id
# CF_ACCESS_KEY_ID=your-key-id
# CF_SECRET_ACCESS_KEY=your-secret
# CF_R2_BUCKET=alpha-erp-uploads
# CF_R2_PUBLIC_URL=https://pub-xxx.r2.dev
